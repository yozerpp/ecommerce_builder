<!DOCTYPE html>
<head>
    <title>{{title}}</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<html>
<body>
<form action="/product" method="post" enctype="multipart/form-data">
    <!-- Name -->
    <div>
        <input type="hidden" name="id" value="{{id}}"/>
    </div>
    <div>
        <label for="name">Name:</label>
        <input type="text" id="name" name="name" value="{{product.name}}" required />
    </div>

    <!-- Image -->
    <div>
        <label for="image">Product Image:</label>
        <input type="file" id="image" name="image" />
    </div>

    <!-- Description -->
    <div>
        <label for="description">Description:</label>
        <textarea id="description" name="description" rows="5" required>{{product.description}}</textarea>
    </div>

    <!-- Tags -->
    <div>
        <label for="tags">Tags:</label>
        <input type="text" id="tags" name="tags" value="{{product.tags}}" placeholder="Enter tags (comma-separated)" />
    </div>

    <!-- Category with Search Suggestions -->
    <div>
        <label for="category">Category:</label>
        <input
            type="text"
            id="category"
            name="category"
            value="{{product.category}}"
            list="categoriesList"
            placeholder="Search categories..."
            autocomplete="off"
            required
        />
        <datalist id="categoriesList">
            {{#categories}}
            <option value="{{.}}"></option>
            {{/categories}}
        </datalist>
    </div>

    <!-- Regular Price -->
    <div>
        <label for="regularPrice">Regular Price:</label>
        <input type="number" id="regularPrice" name="regularPrice" min="0" step="0.01" value="{{product.regularPrice}}" required />
    </div>

    <!-- Discount -->
    <div>
        <label for="discount">Discount (%):</label>
        <input type="number" id="discount" name="discount" min="0" max="100" step="0.01" value="{{product.discount}}" />
    </div>

    <!-- Stock -->
    <div>
        <label for="stock">Stock:</label>
        <input type="number" id="stock" name="stock" min="0" value="{{product.stock}}" required />
    </div>

    <!-- Submit Button -->
    <div>
        <button type="submit">Save Product</button>
    </div>
</form>
</body>
</html>
